# Environment
.env
.env.*
!.env.example

# Live config — generated by setup.py, contains user-specific values
hollow.config.json

# Live agent memory — generated by setup.py and written at runtime
# Contains user profile data and conversation history; never commit live memory
agent-memory/

# User-specific agent customization files (generated from personal profile)
agents/*/voice.md

# SQLite databases
*.db
*.db-shm
*.db-wal

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
dist/
build/
*.egg-info/
.eggs/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
