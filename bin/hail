#!/usr/bin/env python3
"""Route tasks to specialist agents via HTTP POST.

Reads agent list and ports from hollow.config.json at runtime.
Run 'python setup.py' to generate hollow.config.json.

Usage:
    hail <agent> <task> [--user USER_ID] [--context CONTEXT_TEXT]
    hail --detach <agent> <task>         # fire async, print job_id and exit
    hail --poll <job_id> <agent>         # poll /result/<job_id> until done
    hail --detach <agent> <task> --result-channel <channel>  # post result to Discord
    hail --worktree <agent> <task>       # create isolated git worktree, inject path into context
    hail --wait-all <job_id1>:<agent1> <job_id2>:<agent2> ...  # poll all jobs, exit when all done

Options:
    --user USER_ID           Stable per-user chat_id (e.g. Tyler's Telegram ID).
                             Results in chat_id "<agent>_<user>". Defaults to "_main".
    --context TEXT           Context string injected into the agent's system prompt,
                             giving the sub-agent background from the delegating session.
    --model MODEL            Override the model for this specific call (e.g. opus, sonnet).
                             The agent uses its configured default if not specified.
    --detach                 Call /fire instead of /ask; print job_id and exit immediately.
    --poll JOB_ID            Poll /result/<job_id> every 5s until done; exit 0 on success,
                             1 on error. Agent name is still required for URL resolution.
    --result-channel CHANNEL When using --detach, agent posts result to this Discord channel.
    --idempotency-key KEY    Idempotency key for /fire dedup.
    --worktree               Create an isolated git worktree at .claude/worktrees/<agent>-<ts>/
                             before dispatching. Injects worktree path into context so the agent
                             works there. Default autonomy: tyler-checkpoint.
    --wait-all               Poll multiple jobs in round-robin. Each positional arg must be
                             <job_id>:<agent>. Exits 0 when all jobs are done, 1 if any error.
                             Prints combined results to stdout.
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime
from pathlib import Path

HOLLOW_ROOT = Path(__file__).parent.parent.resolve()
CONFIG_PATH = HOLLOW_ROOT / "hollow.config.json"
TIMEOUT = 300
POLL_INTERVAL = 10  # seconds between /result polls

# Short aliases → full Anthropic model IDs.
# Add new aliases here as models are released.
_MODEL_ALIASES: dict[str, str] = {
    "opus":   "claude-opus-4-6",
    "sonnet": "claude-sonnet-4-6",
    "haiku":  "claude-haiku-4-5",
}


_TOOL_NAME_MAP: dict[str, str] = {
    "bash": "Bash",
    "read": "Read",
    "write": "Write",
    "edit": "Edit",
    "glob": "Glob",
    "grep": "Grep",
    "web_search": "WebSearch",
    "web_fetch": "WebFetch",
    "agent": "Agent",
}


def _normalize_tools(tools_arg: str) -> list[str]:
    """Parse --allowed-tools value into a list of SDK tool names.

    Accepts comma-separated names in either config style (bash, web_search) or
    SDK style (Bash, WebSearch). Returns [] for "all" or empty string.
    """
    raw = tools_arg.strip()
    if not raw or raw.lower() == "all":
        return []
    result = []
    for t in raw.split(","):
        t = t.strip()
        if not t:
            continue
        sdk_name = _TOOL_NAME_MAP.get(t.lower(), t)
        result.append(sdk_name)
    return result


def _resolve_model(model_arg: str) -> str:
    """Expand short model aliases to full model IDs.

    Passes through any value that already looks like a full model ID
    (contains a hyphen and is not a known alias).
    """
    if not model_arg:
        return model_arg
    lower = model_arg.lower()
    if lower in _MODEL_ALIASES:
        return _MODEL_ALIASES[lower]
    return model_arg


def load_config() -> dict:
    """Load hollow.config.json."""
    if not CONFIG_PATH.exists():
        print(
            f"Error: hollow.config.json not found at {CONFIG_PATH}\n"
            "Run 'python setup.py' to generate it.",
            file=sys.stderr,
        )
        sys.exit(1)
    try:
        return json.loads(CONFIG_PATH.read_text())
    except (json.JSONDecodeError, OSError) as e:
        print(f"Error: could not parse hollow.config.json: {e}", file=sys.stderr)
        sys.exit(1)


def load_agents(cfg: dict | None = None) -> dict[str, dict]:
    """Load agent name -> {ask_url, fire_url, result_base_url} mapping."""
    if cfg is None:
        cfg = load_config()

    agents: dict[str, dict] = {}

    # Include coordinator (tarn) if present
    coordinator = cfg.get("coordinator", {})
    coord_keyword = coordinator.get("name", "")
    coord_port = coordinator.get("port")
    if coord_keyword and coord_port:
        base = f"http://127.0.0.1:{coord_port}"
        agents[coord_keyword.lower()] = {
            "ask_url": f"{base}/ask",
            "fire_url": f"{base}/fire",
            "result_base": base,
            "tools": coordinator.get("tools", []),
        }

    for agent in cfg.get("agents", []):
        keyword = agent.get("hail_keyword", agent.get("name", ""))
        port = agent.get("port")
        if keyword and port:
            base = f"http://127.0.0.1:{port}"
            agents[keyword.lower()] = {
                "ask_url": f"{base}/ask",
                "fire_url": f"{base}/fire",
                "result_base": base,
                "tools": agent.get("tools", []),
            }

    return agents


def do_ask(url: str, payload_data: dict) -> None:
    """POST to /ask and print the response. Synchronous."""
    payload = json.dumps(payload_data).encode()
    req = urllib.request.Request(
        url, data=payload, headers={"Content-Type": "application/json"}
    )
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
            data = json.loads(resp.read().decode())
            print(data.get("response", json.dumps(data, indent=2)))
    except urllib.error.URLError as e:
        print(f"Error connecting to agent: {e}", file=sys.stderr)
        sys.exit(1)
    except TimeoutError:
        print(f"Timeout after {TIMEOUT}s waiting for agent", file=sys.stderr)
        sys.exit(1)


def do_fire(fire_url: str, payload_data: dict) -> str:
    """POST to /fire, print job_id to stdout, and return job_id."""
    payload = json.dumps(payload_data).encode()
    req = urllib.request.Request(
        fire_url, data=payload, headers={"Content-Type": "application/json"}
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.loads(resp.read().decode())
            job_id = data.get("job_id", "")
            # Print only the job_id so callers can capture it with $()
            print(job_id)
            return job_id
    except urllib.error.URLError as e:
        print(f"Error connecting to /fire: {e}", file=sys.stderr)
        sys.exit(1)


def do_poll(result_base: str, job_id: str) -> None:
    """Poll /result/{job_id} every POLL_INTERVAL seconds until done or error.

    Exits 0 on done (prints response to stdout).
    Exits 1 on error (prints error to stderr).
    """
    url = f"{result_base}/result/{job_id}"
    print(f"Polling {url} every {POLL_INTERVAL}s ...", file=sys.stderr)
    while True:
        try:
            req = urllib.request.Request(url)
            with urllib.request.urlopen(req, timeout=30) as resp:
                data = json.loads(resp.read().decode())
        except urllib.error.HTTPError as e:
            if e.code == 404:
                print(f"Job {job_id} not found (agent may have restarted).", file=sys.stderr)
                sys.exit(1)
            print(f"HTTP error polling {url}: {e}", file=sys.stderr)
            time.sleep(POLL_INTERVAL)
            continue
        except urllib.error.URLError as e:
            print(f"Network error polling {url}: {e}", file=sys.stderr)
            time.sleep(POLL_INTERVAL)
            continue

        status = data.get("status", "pending")
        if status == "done":
            print(data.get("response", ""))
            sys.exit(0)
        elif status == "error":
            print(f"Job {job_id} failed: {data.get('response', 'unknown error')}", file=sys.stderr)
            sys.exit(1)
        elif status == "not_found":
            print(f"Job {job_id} not found.", file=sys.stderr)
            sys.exit(1)
        else:
            # pending — keep waiting
            time.sleep(POLL_INTERVAL)


def do_wait_all(job_agent_pairs: list[tuple[str, str]], agents: dict[str, dict]) -> None:
    """Poll multiple jobs in round-robin until all are done or any fail.

    Each element of job_agent_pairs is (job_id, agent_name).
    Exits 0 when all jobs complete successfully (prints combined results).
    Exits 1 if any job errors or agent is unknown.
    """
    pending: list[tuple[str, str]] = []
    for job_id, agent_name in job_agent_pairs:
        agent_name = agent_name.lower()
        if agent_name not in agents:
            print(f"Unknown agent in --wait-all: {agent_name}", file=sys.stderr)
            print(f"Available: {', '.join(sorted(agents))}", file=sys.stderr)
            sys.exit(1)
        pending.append((job_id, agent_name))

    results: dict[str, str] = {}
    print(
        f"Waiting for {len(pending)} job(s): "
        + ", ".join(f"{jid}:{ag}" for jid, ag in pending),
        file=sys.stderr,
    )

    while pending:
        still_pending: list[tuple[str, str]] = []
        for job_id, agent_name in pending:
            result_base = agents[agent_name]["result_base"]
            url = f"{result_base}/result/{job_id}"
            try:
                req = urllib.request.Request(url)
                with urllib.request.urlopen(req, timeout=30) as resp:
                    data = json.loads(resp.read().decode())
            except urllib.error.HTTPError as e:
                if e.code == 404:
                    print(
                        f"Job {job_id} ({agent_name}) not found (agent may have restarted).",
                        file=sys.stderr,
                    )
                    sys.exit(1)
                print(f"HTTP error polling {url}: {e}", file=sys.stderr)
                still_pending.append((job_id, agent_name))
                continue
            except urllib.error.URLError as e:
                print(f"Network error polling {url}: {e}", file=sys.stderr)
                still_pending.append((job_id, agent_name))
                continue

            status = data.get("status", "pending")
            if status == "done":
                results[job_id] = data.get("response", "")
                print(f"  [{job_id}:{agent_name}] done", file=sys.stderr)
            elif status == "error":
                print(
                    f"Job {job_id} ({agent_name}) failed: {data.get('response', 'unknown error')}",
                    file=sys.stderr,
                )
                sys.exit(1)
            elif status == "not_found":
                print(f"Job {job_id} ({agent_name}) not found.", file=sys.stderr)
                sys.exit(1)
            else:
                # pending — keep in rotation
                still_pending.append((job_id, agent_name))

        pending = still_pending
        if pending:
            time.sleep(POLL_INTERVAL)

    # All done — print combined results
    for job_id, agent_name in job_agent_pairs:
        print(f"=== {job_id} ({agent_name}) ===")
        print(results.get(job_id, ""))
    sys.exit(0)


def main():
    cfg = load_config()
    agents = load_agents(cfg)

    # --wait-all takes the remaining argv as positional <job_id>:<agent> pairs
    # and does not need the normal <agent> <task> positionals — handle it early.
    if "--wait-all" in sys.argv:
        idx = sys.argv.index("--wait-all")
        raw_pairs = sys.argv[idx + 1 :]
        if not raw_pairs:
            print(
                "Usage: hail --wait-all <job_id1>:<agent1> <job_id2>:<agent2> ...",
                file=sys.stderr,
            )
            sys.exit(1)
        job_agent_pairs: list[tuple[str, str]] = []
        for token in raw_pairs:
            if ":" not in token:
                print(
                    f"Invalid --wait-all argument '{token}': expected <job_id>:<agent>",
                    file=sys.stderr,
                )
                sys.exit(1)
            job_id, agent_name = token.split(":", 1)
            job_agent_pairs.append((job_id, agent_name))
        do_wait_all(job_agent_pairs, agents)
        return  # do_wait_all calls sys.exit internally

    parser = argparse.ArgumentParser(
        description="Route tasks to specialist agents via HTTP POST.",
        usage=(
            "hail <agent> <task...> [--user USER_ID] [--context CONTEXT]\n"
            "       hail --detach <agent> <task...> [--result-channel CHANNEL]\n"
            "       hail --poll <job_id> <agent>\n"
            "       hail --wait-all <job_id1>:<agent1> <job_id2>:<agent2> ..."
        ),
    )
    parser.add_argument(
        "agent",
        help="Agent name (required even for --poll, used for URL resolution)",
    )
    parser.add_argument("task", nargs="*", help="Task description (multi-word ok)")
    parser.add_argument(
        "--user",
        default=None,
        metavar="USER_ID",
        help="User identifier for stable per-user chat_id",
    )
    parser.add_argument(
        "--context",
        default="",
        metavar="TEXT",
        help="Context string to inject into the agent's system prompt",
    )
    parser.add_argument(
        "--model",
        default="",
        metavar="MODEL",
        help="Override model for this call (e.g. opus, sonnet, haiku). Agent uses its default if not set.",
    )
    parser.add_argument(
        "--detach",
        action="store_true",
        help="Call /fire instead of /ask; print job_id and exit immediately",
    )
    parser.add_argument(
        "--poll",
        default=None,
        metavar="JOB_ID",
        help="Poll /result/<JOB_ID> every 5s until done; agent arg still required",
    )
    parser.add_argument(
        "--result-channel",
        default="",
        metavar="CHANNEL",
        help="Discord channel name to post result to (only with --detach)",
    )
    parser.add_argument(
        "--idempotency-key",
        default="",
        metavar="KEY",
        help="Idempotency key for /fire dedup",
    )
    parser.add_argument(
        "--worktree",
        action="store_true",
        help=(
            "Create an isolated git worktree at .claude/worktrees/<agent>-<timestamp>/ "
            "before dispatching. Injects worktree path into agent context."
        ),
    )
    parser.add_argument(
        "--allowed-tools",
        default=None,
        metavar="TOOLS",
        help=(
            "Comma-separated tool names for this call (e.g. 'Bash,Read,Glob,Grep'). "
            "Overrides the agent's configured allowlist. Pass 'all' to disable restriction. "
            "If omitted, uses the agent's tools entry from hollow.config.json."
        ),
    )

    if len(sys.argv) < 2:
        parser.print_help()
        print(f"\nAvailable agents: {', '.join(sorted(agents))}")
        sys.exit(1)

    args = parser.parse_args()

    agent_name = args.agent.lower()

    if agent_name not in agents:
        print(f"Unknown agent: {agent_name}")
        print(f"Available: {', '.join(sorted(agents))}")
        sys.exit(1)

    agent_urls = agents[agent_name]

    # ── --poll mode ────────────────────────────────────────────────────────────
    if args.poll:
        do_poll(agent_urls["result_base"], args.poll)
        return  # do_poll calls sys.exit internally

    # ── normal / --detach mode ─────────────────────────────────────────────────
    task_parts = args.task
    if not task_parts:
        parser.print_help()
        print(f"\nAvailable agents: {', '.join(sorted(agents))}")
        sys.exit(1)

    task = " ".join(task_parts)

    user_suffix = args.user if args.user else "main"
    chat_id = f"{agent_name}_{user_suffix}"

    # ── --worktree mode ────────────────────────────────────────────────────────
    worktree_context = ""
    if args.worktree:
        ts = datetime.now().strftime("%Y%m%d-%H%M%S")
        worktree_rel = f".claude/worktrees/{agent_name}-{ts}"
        worktree_path = HOLLOW_ROOT / worktree_rel
        worktree_path.parent.mkdir(parents=True, exist_ok=True)
        try:
            subprocess.run(
                ["git", "worktree", "add", str(worktree_path)],
                cwd=str(HOLLOW_ROOT),
                check=True,
                capture_output=True,
                text=True,
            )
            print(f"Created worktree: {worktree_path}", file=sys.stderr)
        except subprocess.CalledProcessError as e:
            print(f"Error creating worktree: {e.stderr.strip()}", file=sys.stderr)
            sys.exit(1)
        worktree_context = (
            f"You are working in an isolated worktree at {worktree_path}. "
            "Make all file changes there. Do not modify the main working tree. "
            "Default autonomy level: tyler-checkpoint (pause and surface to Tyler "
            "before any irreversible action or when blocked)."
        )

    payload_data: dict = {"message": task, "chat_id": chat_id}
    # Merge worktree context with any explicit --context, worktree context goes first
    combined_context = "\n\n".join(
        part for part in [worktree_context, args.context] if part
    )
    if combined_context:
        payload_data["context"] = combined_context
    if args.model:
        payload_data["model"] = _resolve_model(args.model)

    # ── allowed_tools resolution ───────────────────────────────────────────────
    # Priority: --allowed-tools flag > agent config tools > (no override, server decides)
    if args.allowed_tools is not None:
        # Explicit override from CLI
        tool_list = _normalize_tools(args.allowed_tools)
        if tool_list:
            payload_data["allowed_tools"] = tool_list
        # else "all" → omit field, server treats as unrestricted
    else:
        # Auto-populate from hollow.config.json tools entry
        cfg_tools = agent_urls.get("tools", [])
        if cfg_tools and cfg_tools != ["all"]:
            normalized = [_TOOL_NAME_MAP.get(t.lower(), t) for t in cfg_tools]
            payload_data["allowed_tools"] = normalized

    if args.detach:
        # /fire mode
        if args.result_channel:
            payload_data["result_channel"] = args.result_channel
        if args.idempotency_key:
            payload_data["idempotency_key"] = args.idempotency_key
        do_fire(agent_urls["fire_url"], payload_data)
    else:
        # /ask mode (synchronous)
        do_ask(agent_urls["ask_url"], payload_data)


if __name__ == "__main__":
    main()
