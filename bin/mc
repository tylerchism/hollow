#!/usr/bin/env python3
"""Mission Control CLI — manage tasks, ideas, and activity logs."""

import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

BASE_URL = os.environ.get("MC_BASE_URL", "http://localhost:3333")
API_KEY = os.environ.get("MC_API_KEY", "462f220e3c3f15324825a86373da874f92302bf6fc646e3330731468cc959c22")


def api(method, path, data=None, params=None):
    url = f"{BASE_URL}{path}"
    if params:
        url += "?" + urllib.parse.urlencode(params)
    body = json.dumps(data).encode() if data is not None else None
    req = urllib.request.Request(url, data=body, method=method)
    req.add_header("Content-Type", "application/json")
    req.add_header("x-api-key", API_KEY)
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return json.loads(resp.read().decode())
    except urllib.error.HTTPError as e:
        body = e.read().decode() if e.fp else ""
        print(f"HTTP {e.code}: {body}", file=sys.stderr)
        sys.exit(1)
    except urllib.error.URLError as e:
        print(f"Connection error: {e}", file=sys.stderr)
        sys.exit(1)


def parse_flags(args):
    flags = {}
    positional = []
    for arg in args:
        if arg.startswith("--"):
            if "=" in arg:
                k, v = arg[2:].split("=", 1)
                flags[k] = v
            else:
                flags[arg[2:]] = True
        else:
            positional.append(arg)
    return positional, flags


def main():
    if len(sys.argv) < 3:
        print("Usage: mc <resource> <operation> [args]")
        print("  mc tasks list [--status=<status>]")
        print("  mc tasks create \"<title>\" [--description=\"...\"] [--priority=high|medium|low] [--tags=\"t1,t2\"] [--next-task='{\"title\":\"...\",\"description\":\"...\",\"priority\":\"medium\",\"tags\":[]}'] [--created-by=<value>] [--origin-channel=<value>] [--origin-message-url=<value>] [--isolation=worktree] [--expected-duration-minutes=<N>]")
        print("  mc tasks update <id> [--status=<status>] [--notes=\"...\"] [--description=\"...\"] [--title=\"...\"] [--priority=high|medium|low] [--tags=\"t1,t2\"] [--blocked-reason=\"...\"] [--next-task='{\"title\":\"...\"}'] [--isolation=worktree] [--heartbeat-at=<iso8601>] [--lease-expires-at=<iso8601>] [--locked-by=<executor>] [--expected-duration-minutes=<N>]")
        print("  mc ideas list")
        print("  mc ideas create \"<title>\" [--body=\"...\"] [--type=idea|spike]")
        print("  mc activity list [--limit=N] [--type=<action_type>]")
        print("  mc activity log \"<action>\" [--details=\"...\"] [--route=\"...\"] [--summary=\"...\"] [--action-type=\"...\"]")
        print("    Structured format: mc activity log \"completed: <title> | route: <route> | summary: <summary>\"")
        sys.exit(1)

    resource = sys.argv[1]
    operation = sys.argv[2]
    rest = sys.argv[3:]
    positional, flags = parse_flags(rest)

    if resource == "tasks":
        if operation == "list":
            params = {}
            if "status" in flags:
                params["status"] = flags["status"]
            result = api("GET", "/api/tasks", params=params)
        elif operation == "create":
            if not positional:
                print("Error: title required", file=sys.stderr)
                sys.exit(1)
            body = {"title": positional[0]}
            if "description" in flags:
                body["description"] = flags["description"]
            if "priority" in flags:
                body["priority"] = flags["priority"]
            if "tags" in flags:
                body["tags"] = [t.strip() for t in flags["tags"].split(",")]
            if "next-task" in flags:
                import json as _json
                body["next_task"] = _json.loads(flags["next-task"])
            if "created-by" in flags:
                body["created_by"] = flags["created-by"]
            if "origin-channel" in flags:
                body["origin_channel"] = flags["origin-channel"]
            if "origin-message-url" in flags:
                body["origin_message_url"] = flags["origin-message-url"]
            if "isolation" in flags:
                body["isolation"] = flags["isolation"]
            if "expected-duration-minutes" in flags:
                try:
                    body["expected_duration_minutes"] = int(flags["expected-duration-minutes"])
                except ValueError:
                    print("Error: --expected-duration-minutes must be an integer", file=sys.stderr)
                    sys.exit(1)
            result = api("POST", "/api/tasks", data=body)
        elif operation == "update":
            if not positional:
                print("Error: task id required", file=sys.stderr)
                sys.exit(1)
            task_id = positional[0]
            body = {}
            if "status" in flags:
                body["status"] = flags["status"]
            if "blocked-reason" in flags:
                body["blocked_reason"] = flags["blocked-reason"]
            if "heartbeat-at" in flags:
                body["heartbeat_at"] = flags["heartbeat-at"]
            if "lease-expires-at" in flags:
                body["lease_expires_at"] = flags["lease-expires-at"]
            if "locked-by" in flags:
                body["locked_by"] = flags["locked-by"]
            if "notes" in flags:
                body["notes"] = flags["notes"]
            if "description" in flags:
                body["description"] = flags["description"]
            if "title" in flags:
                body["title"] = flags["title"]
            if "priority" in flags:
                body["priority"] = flags["priority"]
            if "tags" in flags:
                body["tags"] = [t.strip() for t in flags["tags"].split(",")]
            if "next-task" in flags:
                import json as _json
                body["next_task"] = _json.loads(flags["next-task"])
            if "isolation" in flags:
                body["isolation"] = flags["isolation"] if flags["isolation"] != "null" else None
            if "expected-duration-minutes" in flags:
                try:
                    body["expected_duration_minutes"] = int(flags["expected-duration-minutes"])
                except ValueError:
                    print("Error: --expected-duration-minutes must be an integer", file=sys.stderr)
                    sys.exit(1)
            result = api("PATCH", f"/api/tasks/{task_id}", data=body)
        else:
            print(f"Unknown tasks operation: {operation}", file=sys.stderr)
            sys.exit(1)

    elif resource == "ideas":
        if operation == "list":
            result = api("GET", "/api/ideas")
        elif operation == "create":
            if not positional:
                print("Error: title required", file=sys.stderr)
                sys.exit(1)
            body = {"title": positional[0]}
            if "body" in flags:
                body["body"] = flags["body"]
            if "type" in flags:
                body["type"] = flags["type"]
            result = api("POST", "/api/ideas", data=body)
        else:
            print(f"Unknown ideas operation: {operation}", file=sys.stderr)
            sys.exit(1)

    elif resource == "activity":
        if operation == "list":
            params = {}
            if "limit" in flags:
                params["limit"] = flags["limit"]
            if "type" in flags:
                params["type"] = flags["type"]
            result = api("GET", "/api/agent-activity", params=params)
            for entry in result:
                created = entry.get("created_at", "")
                agent = entry.get("agent", "")
                action_type = entry.get("action_type", "")
                action = entry.get("action", "")
                summary = entry.get("summary") or ""
                print(f"[{created}] {agent} | {action_type} | {action}" + (f"\n  summary: {summary}" if summary else ""))
            sys.exit(0)
        elif operation == "log":
            if not positional:
                print("Error: action required", file=sys.stderr)
                sys.exit(1)
            raw_action = positional[0]

            # Parse structured format: "completed: X | route: Y | summary: Z"
            # Split on ' | ' to extract optional route and summary segments.
            parts = [p.strip() for p in raw_action.split(" | ")]
            action_text = parts[0]  # e.g. "completed: Fix the bug"
            extracted_route = None
            extracted_summary = None
            for part in parts[1:]:
                if part.startswith("route:"):
                    extracted_route = part[len("route:"):].strip()
                elif part.startswith("summary:"):
                    extracted_summary = part[len("summary:"):].strip()

            # Derive action_type from the action text prefix (e.g. "completed:" -> "task.completed")
            # Falls back to using the first segment verbatim if no known prefix matches.
            action_prefix_map = {
                "completed:": "task.completed",
                "routing.decision": "routing.decision",
                "task.created": "task.created",
            }
            derived_action_type = None
            for prefix, atype in action_prefix_map.items():
                if action_text.startswith(prefix) or action_text == prefix.rstrip(":"):
                    derived_action_type = atype
                    break
            if derived_action_type is None:
                # Use the raw text as-is for action_type (categorical)
                derived_action_type = action_text

            # Flags override auto-extracted values
            route_chosen = flags.get("route", extracted_route)
            summary = flags.get("summary", extracted_summary)
            action_type = flags.get("action-type", derived_action_type)

            body = {
                "agent": os.environ.get("MC_AGENT", "tarn"),
                "action": raw_action,
                "action_type": action_type,
            }
            if route_chosen:
                body["route_chosen"] = route_chosen
            if summary:
                body["summary"] = summary
            if "details" in flags:
                body["payload"] = {"details": flags["details"]}
            result = api("POST", "/api/agent-activity", data=body)
        else:
            print(f"Unknown activity operation: {operation}", file=sys.stderr)
            sys.exit(1)
    else:
        print(f"Unknown resource: {resource}", file=sys.stderr)
        sys.exit(1)

    print(json.dumps(result, indent=2))


if __name__ == "__main__":
    main()
