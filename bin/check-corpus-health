#!/usr/bin/env python3
"""check-corpus-health — Corpus integrity monitor for ~/data/corpus/ databases.

Checks per corpus:
  1. DB file exists and is non-zero size
  2. ingest.log exists and last entry is within 8 days (weekly scrape staleness)
  3. No errors in the last ingest run (last JSONL entry with errors field)
  4. Chunk count exceeds a stored baseline (detects accidental deletion)

Usage:
    bin/check-corpus-health --corpus <slug>
    bin/check-corpus-health --all

Exit 0 if all checked corpora are healthy.
Exit 1 if any corpus is degraded.

If degraded: sends a Discord alert to #tarn.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sqlite3
import subprocess
import sys
from datetime import datetime, timezone, timedelta
from pathlib import Path
from typing import Optional

# ── Config ────────────────────────────────────────────────────────────────────

HOLLOW_ROOT   = Path(__file__).resolve().parent.parent
TARN_ENV      = HOLLOW_ROOT / "agents" / "tarn" / ".env"
CORPUS_ROOT   = Path("/home/tchism/data/corpus")
BASELINE_FILE = CORPUS_ROOT / ".health-baselines.json"

STALENESS_DAYS    = 8   # ingest.log last entry must be within this many days

# ── .env helpers ──────────────────────────────────────────────────────────────

def load_env(path: Path) -> dict:
    env: dict = {}
    if not path.exists():
        return env
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        m = re.match(r'^([A-Z_][A-Z0-9_]*)=(.*)$', line)
        if m:
            env[m.group(1)] = m.group(2).strip('"').strip("'")
    return env

# ── Discord ───────────────────────────────────────────────────────────────────

def send_discord_alert(text: str) -> bool:
    """Post alert to #tarn via send_discord_channel script."""
    script = HOLLOW_ROOT / "bin" / "send_discord_channel"
    if not script.exists():
        print(f"  [warn] send_discord_channel script not found", file=sys.stderr)
        return False
    try:
        result = subprocess.run(
            [str(script), "tarn", text],
            capture_output=True,
            text=True,
            timeout=30,
        )
        if result.returncode == 0:
            return True
        print(f"  [warn] send_discord_channel failed (rc={result.returncode}): {result.stderr.strip()}", file=sys.stderr)
        return False
    except Exception as e:
        print(f"  [warn] send_discord_channel exception: {e}", file=sys.stderr)
        return False

# ── Baseline helpers ──────────────────────────────────────────────────────────

def load_baselines() -> dict:
    if BASELINE_FILE.exists():
        try:
            return json.loads(BASELINE_FILE.read_text())
        except Exception:
            pass
    return {}


def save_baselines(baselines: dict) -> None:
    BASELINE_FILE.parent.mkdir(parents=True, exist_ok=True)
    BASELINE_FILE.write_text(json.dumps(baselines, indent=2))


def get_chunk_count(db_path: Path) -> Optional[int]:
    try:
        conn = sqlite3.connect(str(db_path))
        cur = conn.cursor()
        cur.execute("SELECT COUNT(*) FROM chunks")
        count = cur.fetchone()[0]
        conn.close()
        return count
    except Exception:
        return None

# ── Per-corpus check ──────────────────────────────────────────────────────────

class HealthResult:
    def __init__(self, slug: str):
        self.slug = slug
        self.issues: list[str] = []
        self.info: list[str] = []

    @property
    def healthy(self) -> bool:
        return len(self.issues) == 0

    def fail(self, msg: str) -> None:
        self.issues.append(msg)

    def note(self, msg: str) -> None:
        self.info.append(msg)


def check_corpus(slug: str, baselines: dict) -> HealthResult:
    result = HealthResult(slug)
    corpus_dir = CORPUS_ROOT / slug
    db_path    = corpus_dir / "memory.db"
    log_path   = corpus_dir / "ingest.log"

    # ── Check 1: DB file exists and is non-zero ───────────────────────────────
    if not db_path.exists():
        result.fail(f"memory.db missing at {db_path}")
    elif db_path.stat().st_size == 0:
        result.fail("memory.db exists but is empty (0 bytes)")
    else:
        result.note(f"DB: {db_path.stat().st_size:,} bytes")

    # ── Check 2: ingest.log exists and is not stale ───────────────────────────
    if not log_path.exists():
        result.fail("ingest.log missing")
    else:
        # Parse JSONL — find the most recent entry with a timestamp
        last_ts: Optional[datetime] = None
        try:
            with log_path.open() as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        entry = json.loads(line)
                        raw_ts = entry.get("timestamp") or entry.get("ts")
                        if raw_ts:
                            # Normalize timezone
                            dt = datetime.fromisoformat(raw_ts.replace("Z", "+00:00"))
                            if last_ts is None or dt > last_ts:
                                last_ts = dt
                    except (json.JSONDecodeError, ValueError):
                        continue
        except Exception as e:
            result.fail(f"ingest.log unreadable: {e}")

        if last_ts is None:
            result.fail("ingest.log has no parseable timestamp entries")
        else:
            now = datetime.now(timezone.utc)
            age_days = (now - last_ts).total_seconds() / 86400
            if age_days > STALENESS_DAYS:
                result.fail(
                    f"ingest.log is stale: last entry {age_days:.1f} days ago "
                    f"(threshold: {STALENESS_DAYS} days)"
                )
            else:
                result.note(f"Last ingest: {age_days:.1f} days ago")

    # ── Check 3: No errors in the last ingest run ─────────────────────────────
    # "Last run" = the last JSONL entry that contains an "errors" field.
    # The JSONL format written by bin/ingest includes errors as a list.
    if log_path.exists():
        last_run_entry: Optional[dict] = None
        try:
            with log_path.open() as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        entry = json.loads(line)
                        if "errors" in entry:
                            last_run_entry = entry
                    except (json.JSONDecodeError, ValueError):
                        continue
        except Exception:
            pass

        if last_run_entry is not None:
            errors = last_run_entry.get("errors", [])
            if errors:
                result.fail(
                    f"Last ingest run had {len(errors)} error(s): "
                    + "; ".join(str(e) for e in errors[:3])
                    + ("..." if len(errors) > 3 else "")
                )
            else:
                result.note("Last ingest run: no errors")
        else:
            result.note("ingest.log has no run entries with errors field")

    # ── Check 4: Chunk count above baseline ───────────────────────────────────
    if db_path.exists() and db_path.stat().st_size > 0:
        chunk_count = get_chunk_count(db_path)
        if chunk_count is None:
            result.fail("Could not query chunk count from DB")
        else:
            result.note(f"Chunks: {chunk_count:,}")
            baseline_key = slug
            if baseline_key not in baselines:
                # First run — record baseline
                baselines[baseline_key] = {"chunk_baseline": chunk_count}
                save_baselines(baselines)
                result.note(f"Baseline established: {chunk_count:,} chunks")
            else:
                stored = baselines[baseline_key].get("chunk_baseline", 0)
                if chunk_count < stored:
                    pct = 100.0 * (stored - chunk_count) / stored if stored else 0
                    result.fail(
                        f"Chunk count dropped: {chunk_count:,} vs baseline {stored:,} "
                        f"({pct:.1f}% loss — possible accidental deletion)"
                    )
                else:
                    # Update baseline if count grew (ratchet upward)
                    if chunk_count > stored:
                        baselines[baseline_key]["chunk_baseline"] = chunk_count
                        save_baselines(baselines)
                    result.note(f"Chunk baseline: {stored:,} (OK)")

    return result

# ── Formatting ────────────────────────────────────────────────────────────────

def format_result(result: HealthResult) -> str:
    status = "HEALTHY" if result.healthy else "DEGRADED"
    lines = [f"[{result.slug}] {status}"]
    for info in result.info:
        lines.append(f"  - {info}")
    for issue in result.issues:
        lines.append(f"  ! {issue}")
    return "\n".join(lines)

# ── Main ──────────────────────────────────────────────────────────────────────

def main() -> None:
    parser = argparse.ArgumentParser(
        description="Check health of corpus databases in ~/data/corpus/",
    )
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--corpus", metavar="SLUG", help="Check a single corpus by slug")
    group.add_argument("--all", action="store_true", help="Check all corpora in ~/data/corpus/")
    args = parser.parse_args()

    # Collect slugs to check
    if args.all:
        if not CORPUS_ROOT.exists():
            print(f"Corpus root does not exist: {CORPUS_ROOT}", file=sys.stderr)
            sys.exit(1)
        slugs = sorted(
            d.name for d in CORPUS_ROOT.iterdir()
            if d.is_dir() and not d.name.startswith(".")
        )
        if not slugs:
            print(f"No corpus directories found in {CORPUS_ROOT}")
            sys.exit(0)
    else:
        slugs = [args.corpus]

    baselines = load_baselines()
    results: list[HealthResult] = []

    for slug in slugs:
        result = check_corpus(slug, baselines)
        results.append(result)
        print(format_result(result))
        print()

    degraded = [r for r in results if not r.healthy]

    if degraded:
        print(f"Summary: {len(degraded)}/{len(results)} corpus(es) DEGRADED")
    else:
        print(f"Summary: all {len(results)} corpus(es) healthy")

    # Send Discord alert if any corpus is degraded
    if degraded:
        ts_str = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        alert_lines = [f"[check-corpus-health] {len(degraded)} corpus(es) DEGRADED\n{ts_str}"]
        for r in degraded:
            alert_lines.append(f"\n{format_result(r)}")
        alert_text = "\n".join(alert_lines)
        ok = send_discord_alert(alert_text)
        if ok:
            print("Discord alert sent to #tarn.")
        else:
            print("WARNING: Discord alert failed to send.", file=sys.stderr)
        sys.exit(1)
    else:
        sys.exit(0)


if __name__ == "__main__":
    main()
