#!/usr/bin/env bash
# Restart the Tarn agent process.
# Thin wrapper around bin/restart-agent — delegates all kill/wait/launch logic
# there so every agent gets the same restart safety guarantees.
#
# Safe to call from within the running Tarn process — this bash script is its
# own OS process and survives independently even if its Python parent is killed.

set -euo pipefail

TARN_PORT=18800
TARN_DIR="$(cd "$(dirname "$0")/.." && pwd)"
LOG_FILE="/tmp/tarn.log"

exec "$TARN_DIR/bin/restart-agent" tarn "$TARN_PORT" "$LOG_FILE" \
  /home/tchism/.local/bin/uv run python -m src.main \
  --port "$TARN_PORT" \
  --identity-dir "$TARN_DIR/agents/tarn" \
  --memory-dir "$TARN_DIR/agent-memory/tarn" \
  --data-dir "$TARN_DIR/data/tarn"
