#!/usr/bin/env bash
# bin/wait-job <agent> <job_id> [--task-id <mc_task_id>]
#
# Polls /result/<job_id> on the target agent every 30s.
# On each poll, heartbeats the MC task if --task-id provided.
#
# Exits 0 with response on stdout on success.
# Exits 1 with error message on stderr on error.
# Exits 2 on timeout (>120 polls = 60 min).

set -euo pipefail

HOLLOW_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CONFIG="$HOLLOW_ROOT/hollow.config.json"
MC_BASE="http://localhost:3333"
MC_API_KEY="462f220e3c3f15324825a86373da874f92302bf6fc646e3330731468cc959c22"

POLL_INTERVAL=30
MAX_POLLS=120   # 120 * 30s = 60 minutes

usage() {
    echo "Usage: wait-job <agent> <job_id> [--task-id <mc_task_id>]" >&2
    echo "" >&2
    echo "  <agent>    Agent name (used to resolve port from hollow.config.json)" >&2
    echo "  <job_id>   Fire job ID returned by /fire or hail --detach" >&2
    echo "  --task-id  MC task ID to heartbeat on each poll" >&2
    exit 1
}

if [[ $# -lt 2 ]]; then
    usage
fi

AGENT_NAME="${1,,}"   # lowercase
JOB_ID="$2"
shift 2

TASK_ID=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --task-id)
            TASK_ID="${2:-}"
            shift 2
            ;;
        *)
            echo "Unknown argument: $1" >&2
            usage
            ;;
    esac
done

# Resolve agent port from hollow.config.json
resolve_port() {
    local name="$1"
    python3 - <<PYEOF
import json, sys
cfg = json.loads(open('$CONFIG').read())
name = '$name'.lower()

# Check coordinator
coord = cfg.get('coordinator', {})
if coord.get('name', '').lower() == name and coord.get('port'):
    print(coord['port'])
    sys.exit(0)

# Check agents
for agent in cfg.get('agents', []):
    kw = agent.get('hail_keyword', agent.get('name', '')).lower()
    if kw == name and agent.get('port'):
        print(agent['port'])
        sys.exit(0)

print('', end='')
sys.exit(1)
PYEOF
}

PORT="$(resolve_port "$AGENT_NAME")"
if [[ -z "$PORT" ]]; then
    echo "Error: unknown agent '$AGENT_NAME' — not found in hollow.config.json" >&2
    exit 1
fi

RESULT_BASE="http://127.0.0.1:${PORT}"
RESULT_URL="${RESULT_BASE}/result/${JOB_ID}"

# Heartbeat helper: PATCH the MC task with fresh heartbeat_at and lease_expires_at (+120 min)
heartbeat_task() {
    if [[ -z "$TASK_ID" ]]; then
        return 0
    fi
    local now
    local lease
    now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    lease="$(date -u -d '+120 minutes' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -v+120M +%Y-%m-%dT%H:%M:%SZ)"
    curl -s -X PATCH "${MC_BASE}/api/tasks/${TASK_ID}" \
        -H "Content-Type: application/json" \
        -H "x-api-key: ${MC_API_KEY}" \
        -d "{\"heartbeat_at\": \"${now}\", \"lease_expires_at\": \"${lease}\"}" \
        > /dev/null 2>&1 || true
}

echo "wait-job: polling ${RESULT_URL} every ${POLL_INTERVAL}s (max ${MAX_POLLS} polls = $((MAX_POLLS * POLL_INTERVAL / 60)) min)" >&2
if [[ -n "$TASK_ID" ]]; then
    echo "wait-job: heartbeating MC task ${TASK_ID} on each poll" >&2
fi

poll_count=0
while [[ $poll_count -lt $MAX_POLLS ]]; do
    poll_count=$((poll_count + 1))

    # Heartbeat the MC task before polling
    heartbeat_task

    # Poll /result/<job_id>
    http_code=""
    response_body=""
    response_body="$(curl -s -w '\n__HTTP_CODE__:%{http_code}' "${RESULT_URL}" 2>/dev/null || true)"
    http_code="$(echo "$response_body" | grep -o '__HTTP_CODE__:[0-9]*' | cut -d: -f2)"
    response_body="$(echo "$response_body" | sed 's/__HTTP_CODE__:[0-9]*$//')"

    if [[ "$http_code" == "404" ]]; then
        echo "wait-job: job ${JOB_ID} not found (404) — agent may have restarted" >&2
        exit 1
    fi

    if [[ -z "$response_body" ]]; then
        echo "wait-job: empty response on poll ${poll_count}/${MAX_POLLS}, retrying..." >&2
        sleep "$POLL_INTERVAL"
        continue
    fi

    status="$(echo "$response_body" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('status','pending'))" 2>/dev/null || echo 'pending')"

    case "$status" in
        done)
            result="$(echo "$response_body" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('response',''))" 2>/dev/null || echo '')"
            echo "$result"
            exit 0
            ;;
        error)
            err="$(echo "$response_body" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('response','unknown error'))" 2>/dev/null || echo 'unknown error')"
            echo "wait-job: job ${JOB_ID} failed: ${err}" >&2
            exit 1
            ;;
        not_found)
            echo "wait-job: job ${JOB_ID} not found" >&2
            exit 1
            ;;
        pending)
            echo "wait-job: poll ${poll_count}/${MAX_POLLS} — still pending..." >&2
            sleep "$POLL_INTERVAL"
            ;;
        *)
            echo "wait-job: poll ${poll_count}/${MAX_POLLS} — unknown status '${status}', retrying..." >&2
            sleep "$POLL_INTERVAL"
            ;;
    esac
done

echo "wait-job: timeout after $((MAX_POLLS * POLL_INTERVAL / 60)) minutes waiting for job ${JOB_ID}" >&2
exit 2
