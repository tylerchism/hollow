#!/usr/bin/env bash
# bin/wait-job <agent> <job_id> [--task-id <mc_task_id>] [--max-minutes <N>]
#
# Polls /result/<job_id> on the target agent every 30s.
# On each poll, heartbeats the MC task if --task-id provided.
#
# Exit codes:
#   0 — done (response printed to stdout)
#   1 — error (job failed; error message on stderr)
#   2 — cancelled or 404 (agent restarted; caller should re-fire)
#   3 — timeout (--max-minutes exceeded)

set -euo pipefail

HOLLOW_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CONFIG="$HOLLOW_ROOT/hollow.config.json"
MC_BASE="${MC_BASE_URL:-http://localhost:3333}"
MC_API_KEY="${MC_API_KEY:-462f220e3c3f15324825a86373da874f92302bf6fc646e3330731468cc959c22}"

POLL_INTERVAL=30
MAX_MINUTES=120

usage() {
    echo "Usage: wait-job <agent> <job_id> [--task-id <mc_task_id>] [--max-minutes <N>]" >&2
    echo "" >&2
    echo "  <agent>          Agent name (resolves port from hollow.config.json)" >&2
    echo "  <job_id>         Fire job ID from /fire or hail --detach" >&2
    echo "  --task-id        MC task ID to heartbeat on each poll" >&2
    echo "  --max-minutes    Max wait time in minutes (default: 120)" >&2
    echo "" >&2
    echo "Exit codes: 0=done  1=error  2=cancelled/404  3=timeout" >&2
    exit 1
}

if [[ $# -lt 2 ]]; then
    usage
fi

AGENT_NAME="${1,,}"   # lowercase
JOB_ID="$2"
shift 2

TASK_ID=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --task-id)
            TASK_ID="${2:-}"
            shift 2
            ;;
        --max-minutes)
            MAX_MINUTES="${2:-120}"
            shift 2
            ;;
        *)
            echo "Unknown argument: $1" >&2
            usage
            ;;
    esac
done

MAX_POLLS=$(( (MAX_MINUTES * 60 + POLL_INTERVAL - 1) / POLL_INTERVAL ))

# Resolve agent port from hollow.config.json
resolve_port() {
    local name="$1"
    python3 - <<PYEOF
import json, sys
try:
    cfg = json.loads(open('$CONFIG').read())
except Exception as e:
    print(f'Error reading config: {e}', file=sys.stderr)
    sys.exit(1)
name = '$name'.lower()

# Check coordinator
coord = cfg.get('coordinator', {})
if coord.get('name', '').lower() == name and coord.get('port'):
    print(coord['port'])
    sys.exit(0)

# Check agents
for agent in cfg.get('agents', []):
    kw = agent.get('hail_keyword', agent.get('name', '')).lower()
    if kw == name and agent.get('port'):
        print(agent['port'])
        sys.exit(0)

sys.exit(1)
PYEOF
}

PORT="$(resolve_port "$AGENT_NAME")"
if [[ -z "$PORT" ]]; then
    echo "Error: unknown agent '$AGENT_NAME' — not found in hollow.config.json" >&2
    exit 2
fi

RESULT_BASE="http://127.0.0.1:${PORT}"
RESULT_URL="${RESULT_BASE}/result/${JOB_ID}"

# Heartbeat helper: PATCH the MC task with fresh heartbeat_at and lease_expires_at (+120 min)
heartbeat_task() {
    if [[ -z "$TASK_ID" ]]; then
        return 0
    fi
    local now lease
    now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    # GNU date vs macOS date
    lease="$(date -u -d '+120 minutes' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \
        || date -u -v+120M +%Y-%m-%dT%H:%M:%SZ 2>/dev/null \
        || echo "$now")"
    curl -s -X PATCH "${MC_BASE}/api/tasks/${TASK_ID}" \
        -H "Content-Type: application/json" \
        -H "x-api-key: ${MC_API_KEY}" \
        -d "{\"heartbeat_at\": \"${now}\", \"lease_expires_at\": \"${lease}\"}" \
        > /dev/null 2>&1 || true
}

echo "wait-job: polling ${RESULT_URL} every ${POLL_INTERVAL}s (max ${MAX_MINUTES} min = ${MAX_POLLS} polls)" >&2
if [[ -n "$TASK_ID" ]]; then
    echo "wait-job: heartbeating MC task ${TASK_ID} on each poll" >&2
fi

poll_count=0
while [[ $poll_count -lt $MAX_POLLS ]]; do
    poll_count=$((poll_count + 1))

    # Heartbeat the MC task before polling
    heartbeat_task

    # Poll /result/<job_id>
    http_status=""
    response_body=""
    full_output="$(curl -s -w '\n__HTTP_CODE__:%{http_code}' "${RESULT_URL}" 2>/dev/null || true)"
    http_status="$(printf '%s' "$full_output" | grep -o '__HTTP_CODE__:[0-9]*' | cut -d: -f2)"
    response_body="$(printf '%s' "$full_output" | sed 's/__HTTP_CODE__:[0-9]*$//' | sed '/^[[:space:]]*$/d')"

    # 404 means the job doesn't exist — agent restarted or TTL expired
    if [[ "$http_status" == "404" ]]; then
        echo "wait-job: job ${JOB_ID} not found (404) — agent restarted or job expired" >&2
        exit 2
    fi

    if [[ -z "$response_body" ]]; then
        echo "wait-job: empty response on poll ${poll_count}/${MAX_POLLS}, retrying..." >&2
        sleep "$POLL_INTERVAL"
        continue
    fi

    status="$(printf '%s' "$response_body" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('status','pending'))" 2>/dev/null || echo 'pending')"

    case "$status" in
        done)
            result="$(printf '%s' "$response_body" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('response',''))" 2>/dev/null || echo '')"
            echo "$result"
            exit 0
            ;;
        error)
            err="$(printf '%s' "$response_body" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('response','unknown error'))" 2>/dev/null || echo 'unknown error')"
            echo "wait-job: job ${JOB_ID} failed: ${err}" >&2
            exit 1
            ;;
        cancelled)
            echo "wait-job: job ${JOB_ID} was cancelled" >&2
            exit 2
            ;;
        not_found)
            echo "wait-job: job ${JOB_ID} not found" >&2
            exit 2
            ;;
        pending)
            echo "wait-job: poll ${poll_count}/${MAX_POLLS} — still pending..." >&2
            sleep "$POLL_INTERVAL"
            ;;
        *)
            echo "wait-job: poll ${poll_count}/${MAX_POLLS} — unknown status '${status}', retrying..." >&2
            sleep "$POLL_INTERVAL"
            ;;
    esac
done

echo "wait-job: timeout after ${MAX_MINUTES} minutes waiting for job ${JOB_ID}" >&2
exit 3
