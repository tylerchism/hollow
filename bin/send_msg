#!/usr/bin/env bash
# send_msg — Send an interim message on the currently active Discord channel.
#
# Usage: send_msg [-a <agent>] "message text"
#        send_msg "message text"   (defaults to HOLLOW_AGENT env var, then "tarn")
#
# Checks /tmp/hollow_active_discord_<agent> and sends to that channel.
# If no active Discord channel is set, exits with error.
#
# The agent name is resolved in this order:
#   1. -a <agent> flag
#   2. HOLLOW_AGENT environment variable
#   3. Default: "tarn"
#
# This is the unified interim-messaging script for soul.md.
# Telegram has been removed; Discord is the only channel.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

AGENT_NAME="${HOLLOW_AGENT:-tarn}"

# Parse optional -a <agent> flag
while [[ $# -gt 0 ]]; do
    case "$1" in
        -a|--agent)
            AGENT_NAME="$2"
            shift 2
            ;;
        *)
            break
            ;;
    esac
done

if [[ $# -lt 1 ]]; then
    echo "Usage: send_msg [-a <agent>] \"message text\"" >&2
    exit 1
fi

MESSAGE="$*"

DISCORD_ACTIVE_FILE="/tmp/hollow_active_discord_${AGENT_NAME}"

if [[ ! -f "$DISCORD_ACTIVE_FILE" ]]; then
    echo "send_msg: no active Discord channel (no inbound message received yet)" >&2
    exit 1
fi

DISCORD_CHANNEL="$(cat "$DISCORD_ACTIVE_FILE")"
if [[ -z "$DISCORD_CHANNEL" ]]; then
    echo "send_msg: active Discord channel is empty" >&2
    exit 1
fi

"$SCRIPT_DIR/send_discord" -a "$AGENT_NAME" "$MESSAGE"
