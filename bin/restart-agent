#!/usr/bin/env bash
# restart-agent — generic agent restart script.
#
# Usage: restart-agent [--origin-channel CHANNEL_ID] NAME PORT LAUNCH_CMD...
#
#   --origin-channel CHANNEL_ID
#               Optional Discord channel ID that triggered the restart.
#               When set, written to /tmp/<NAME>_restart_origin_channel so
#               the new process sends the startup context review only to
#               that channel (origin-channel routing).
#               Watchdog callers should NOT set this flag.
#
#   NAME        Agent name (for logging and pgrep pattern).
#               Log file is derived as /tmp/<NAME>.log.
#   PORT        Port the agent binds on.
#   LAUNCH_CMD  Full launch command and arguments (remaining args).
#
# Mirrors the same SIGTERM → wait → SIGKILL → TIME_WAIT pattern so all
# agents get equivalent restart safety guarantees.
#
# Safe to call from within the running agent process — this bash script is
# its own OS process and survives independently even if its Python parent
# is killed.

set -euo pipefail

# Parse optional flags
ORIGIN_CHANNEL=""
RESTART_REASON=""

while true; do
  case "${1:-}" in
    --origin-channel)
      ORIGIN_CHANNEL="${2:?restart-agent: --origin-channel requires a CHANNEL_ID argument}"
      shift 2
      ;;
    --reason)
      RESTART_REASON="${2:?restart-agent: --reason requires a reason argument}"
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

NAME="${1:?restart-agent: NAME is required}"
PORT="${2:?restart-agent: PORT is required}"
shift 2
LAUNCH_CMD=("$@")

if [ ${#LAUNCH_CMD[@]} -eq 0 ]; then
  echo "[restart-agent:$NAME] ERROR: LAUNCH_CMD is empty. Nothing to start." >&2
  exit 1
fi

HOLLOW_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
LOG_FILE="${HOLLOW_ROOT}/data/${NAME}.log"
RESTART_LOG="${HOLLOW_ROOT}/data/hollow-restart-log.jsonl"

# ── Phase 0: write restart traceability log entry ────────────────────────────
# Determine trigger type from reason prefix, default to "manual"
_TRIGGER="manual"
_DETAIL="${RESTART_REASON:-unknown}"
if [ -z "$RESTART_REASON" ]; then
  _TRIGGER="manual"
  _DETAIL="unknown"
elif echo "$RESTART_REASON" | grep -q "^watchdog:"; then
  _TRIGGER="watchdog"
elif echo "$RESTART_REASON" | grep -q "^maintenance"; then
  _TRIGGER="maintenance"
elif echo "$RESTART_REASON" | grep -q "^tarn-self\|^self"; then
  _TRIGGER="tarn-self"
fi

_TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
_LOG_ENTRY="{\"timestamp\": \"${_TS}\", \"trigger\": \"${_TRIGGER}\", \"detail\": \"${_DETAIL}\", \"agent\": \"${NAME}\"}"
echo "$_LOG_ENTRY" >> "$RESTART_LOG"
echo "[restart-agent:$NAME] Restart event logged (trigger=${_TRIGGER})"

# Write reason to /tmp/<NAME>_restart_reason so new process can read it on startup
printf '%s' "${_DETAIL}" > "/tmp/${NAME}_restart_reason"

# ── Phase 1: pre-kill snapshot ───────────────────────────────────────────────
# Call POST /snapshot on the running process so it can persist its current
# background-task and cron state before we send SIGTERM.  2-second timeout,
# fail-silent — a dead or slow agent should not block the restart.
_AGENT_PORT="$PORT"
echo "[restart-agent:$NAME] Requesting pre-kill snapshot from port $_AGENT_PORT..."
curl -s -X POST "http://127.0.0.1:${_AGENT_PORT}/snapshot" \
  --max-time 2 \
  -H "Content-Type: application/json" \
  >/dev/null 2>&1 || true

# ── Phase 3: write origin-channel file ───────────────────────────────────────
# If --origin-channel was supplied, write it to /tmp so the new process can
# read it on startup and route the context review to the correct channel only.
if [ -n "$ORIGIN_CHANNEL" ]; then
  echo "[restart-agent:$NAME] Writing origin channel ($ORIGIN_CHANNEL) to /tmp/${NAME}_restart_origin_channel"
  printf '%s' "$ORIGIN_CHANNEL" > "/tmp/${NAME}_restart_origin_channel"
fi

echo "[restart-agent:$NAME] Killing all old $NAME processes..."

# Kill by port (process holding the socket)
OLD_PIDS=$(lsof -ti:"$PORT" 2>/dev/null || true)
# Kill any stale processes by identity-dir pattern — catches processes that
# started but haven't bound to the port yet (root cause of pile-up restarts).
# Exclude our own process tree ($$, $PPID) so we don't kill ourselves — the
# launch_cmd arguments on our command line also match the pattern.
PATTERN_PIDS=$(pgrep -f "identity-dir.*agents/$NAME" 2>/dev/null || true)
# Filter out this script's own PID and parent PID to avoid self-kill
_SELF_PIDS="$$ $PPID"
FILTERED_PIDS=""
for _p in $PATTERN_PIDS; do
  _skip=0
  for _s in $_SELF_PIDS; do
    [ "$_p" = "$_s" ] && _skip=1 && break
  done
  [ "$_skip" -eq 0 ] && FILTERED_PIDS="$FILTERED_PIDS $_p"
done
PATTERN_PIDS="$FILTERED_PIDS"

ALL_PIDS=$(echo "$OLD_PIDS $PATTERN_PIDS" | tr ' ' '\n' | sort -u | grep -v '^$' | tr '\n' ' ')

if [ -n "$(echo "$ALL_PIDS" | tr -d ' ')" ]; then
  for pid in $ALL_PIDS; do
    echo "[restart-agent:$NAME] Sending SIGTERM to pid=$pid"
    kill "$pid" 2>/dev/null || true
  done
else
  echo "[restart-agent:$NAME] No old $NAME processes found."
fi

echo "[restart-agent:$NAME] Waiting up to 5s for port $PORT to free after SIGTERM..."
PORT_FREE=0
for i in $(seq 1 5); do
  if ! lsof -ti:"$PORT" >/dev/null 2>&1; then
    echo "[restart-agent:$NAME] Port $PORT is free."
    PORT_FREE=1
    break
  fi
  echo "[restart-agent:$NAME] Port still in use, waiting... (${i}/5)"
  sleep 1
done

if [ "$PORT_FREE" -eq 0 ]; then
  echo "[restart-agent:$NAME] Port still held after 5s — escalating to SIGKILL..."
  for pid in $ALL_PIDS; do
    if kill -0 "$pid" 2>/dev/null; then
      echo "[restart-agent:$NAME] Sending SIGKILL to pid=$pid"
      kill -9 "$pid" 2>/dev/null || true
    fi
  done

  echo "[restart-agent:$NAME] Waiting up to 5s for port $PORT to free after SIGKILL..."
  for i in $(seq 1 5); do
    if ! lsof -ti:"$PORT" >/dev/null 2>&1; then
      echo "[restart-agent:$NAME] Port $PORT is free."
      PORT_FREE=1
      break
    fi
    echo "[restart-agent:$NAME] Port still in use, waiting... (${i}/5)"
    sleep 1
  done
fi

if [ "$PORT_FREE" -eq 0 ]; then
  echo "[restart-agent:$NAME] ERROR: Port $PORT still in use after SIGKILL escalation. Aborting restart." >&2
  exit 1
fi

# Extra buffer: lsof reports the port free before the OS fully releases the
# socket (TIME_WAIT state). Give the new process 2 extra seconds so it can
# bind on the first attempt.
echo "[restart-agent:$NAME] Waiting 2s for socket TIME_WAIT to fully clear..."
sleep 2

echo "[restart-agent:$NAME] Starting new $NAME process..."

# Ensure log file directory exists
mkdir -p "$(dirname "$LOG_FILE")"

# Start the new process fully detached so it survives this script exiting.
# setsid creates a new session; nohup keeps it alive after the parent dies.
cd "$HOLLOW_ROOT"
setsid nohup "${LAUNCH_CMD[@]}" >> "$LOG_FILE" 2>&1 &

NEW_PID=$!
disown "$NEW_PID" 2>/dev/null || true
echo "[restart-agent:$NAME] New $NAME started (pid=$NEW_PID), log=$LOG_FILE"
echo "[restart-agent:$NAME] Done."
