#!/usr/bin/env bash
# send_discord_channel — Send a message to a named Discord channel.
#
# Usage: send_discord_channel <channel-name> "message text"
#
# Unlike send_discord (which posts to whichever channel is currently active),
# this script posts to a SPECIFIC Discord channel by name (e.g. "morning-brief",
# "tasks", "ideas"). The bot must be a member of the guild containing that channel.
#
# Channel name is looked up across all guilds the bot belongs to via the
# Discord Bot API. The bot token is read from agents/tarn/.env.
#
# This is the preferred script for cron jobs that deliver output to a dedicated
# channel rather than the interactive #tarn channel.
#
# Example:
#   send_discord_channel "morning-brief" "Good morning, here is your brief..."
#   send_discord_channel "tasks" "Backlog triage complete. 3 tasks moved to ready."

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOLLOW_ROOT="$(dirname "$SCRIPT_DIR")"
TARN_ENV="$HOLLOW_ROOT/agents/tarn/.env"

if [[ $# -lt 2 ]]; then
    echo "Usage: send_discord_channel <channel-name> \"message text\"" >&2
    exit 1
fi

CHANNEL_NAME="$1"
shift
MESSAGE="$*"

# Load DISCORD_BOT_TOKEN from tarn's .env
if [[ ! -f "$TARN_ENV" ]]; then
    echo "send_discord_channel: tarn .env not found at $TARN_ENV" >&2
    exit 1
fi

TOKEN=""
while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    [[ "$line" =~ ^# ]] && continue
    [[ "$line" =~ ^DISCORD_BOT_TOKEN=(.+)$ ]] && TOKEN="${BASH_REMATCH[1]}" && break
done < "$TARN_ENV"

if [[ -z "$TOKEN" ]]; then
    echo "send_discord_channel: DISCORD_BOT_TOKEN not found in $TARN_ENV" >&2
    exit 1
fi

# Fetch guilds the bot belongs to
GUILDS_JSON="$(curl -s \
    "https://discord.com/api/v10/users/@me/guilds" \
    -H "Authorization: Bot ${TOKEN}")"

GUILD_IDS="$(echo "$GUILDS_JSON" | python3 -c "
import json, sys
guilds = json.load(sys.stdin)
if isinstance(guilds, list):
    for g in guilds:
        print(g['id'])
" 2>/dev/null || true)"

if [[ -z "$GUILD_IDS" ]]; then
    echo "send_discord_channel: bot is not in any guilds, or failed to fetch guilds" >&2
    echo "  API response: $GUILDS_JSON" >&2
    exit 1
fi

SENT=false
CHANNEL_NAME_LOWER="${CHANNEL_NAME,,}"

for GUILD_ID in $GUILD_IDS; do
    # Fetch channels for this guild
    CHANNELS_JSON="$(curl -s \
        "https://discord.com/api/v10/guilds/${GUILD_ID}/channels" \
        -H "Authorization: Bot ${TOKEN}")"

    CHANNEL_ID="$(echo "$CHANNELS_JSON" | python3 -c "
import json, sys
channels = json.load(sys.stdin)
target = sys.argv[1].lower()
if isinstance(channels, list):
    for ch in channels:
        if ch.get('type') == 0 and ch.get('name', '').lower() == target:
            print(ch['id'])
            break
" "$CHANNEL_NAME_LOWER" 2>/dev/null || true)"

    if [[ -z "$CHANNEL_ID" ]]; then
        continue
    fi

    # Send the message
    RESPONSE="$(curl -s -X POST \
        "https://discord.com/api/v10/channels/${CHANNEL_ID}/messages" \
        -H "Authorization: Bot ${TOKEN}" \
        -H "Content-Type: application/json" \
        -d "{\"content\": $(python3 -c "import json,sys; print(json.dumps(sys.argv[1]))" "$MESSAGE")}")"

    OK="$(echo "$RESPONSE" | python3 -c "import json,sys; d=json.load(sys.stdin); print('true' if 'id' in d else 'false')" 2>/dev/null || echo "false")"

    if [[ "$OK" == "true" ]]; then
        SENT=true
        break
    else
        echo "send_discord_channel: Discord API error for channel #${CHANNEL_NAME} (id=${CHANNEL_ID}): $RESPONSE" >&2
    fi
done

if [[ "$SENT" != "true" ]]; then
    echo "send_discord_channel: channel '#${CHANNEL_NAME}' not found on any guild the bot belongs to" >&2
    exit 1
fi

exit 0
