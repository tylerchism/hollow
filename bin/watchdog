#!/usr/bin/env python3
# -*- coding: utf-8 -*-
from __future__ import annotations
"""
watchdog — Ping all hollow agents, send Discord alert if any are unresponsive.

Usage:
    watchdog               # Check all agents, alert on failures
    watchdog --restart     # Also attempt to restart dead agents
    watchdog --once        # Skip cooldown (force alert even if recently notified)

Designed to run as a cron job every 5 minutes:
    */5 * * * * /path/to/hollow/bin/watchdog >> /path/to/hollow/data/watchdog.log 2>&1

Cooldown: won't re-alert for the same agent within COOLDOWN_MINUTES (default: 15).
State file: /tmp/hollow-watchdog-state.json
"""

import argparse
import json
import os
import re
import subprocess
import sys
import time
import urllib.request
import urllib.error
import urllib.parse
from datetime import datetime, timezone
from pathlib import Path
from typing import Optional

# ── Config ────────────────────────────────────────────────────────────────────

HOLLOW_ROOT   = Path(__file__).resolve().parent.parent
CONFIG_FILE   = HOLLOW_ROOT / "hollow.config.json"
TARN_ENV      = HOLLOW_ROOT / "agents" / "tarn" / ".env"
PID_FILE      = HOLLOW_ROOT / ".hollow.pids"
LOG_DIR       = HOLLOW_ROOT / "data"
STATE_FILE    = Path("/tmp/hollow-watchdog-state.json")
LOCK_FILE     = Path("/tmp/hollow-watchdog.lock")

HEALTH_TIMEOUT  = 5       # seconds per agent health check
COOLDOWN_MINUTES = 15     # don't re-alert same agent within this window
# Discord channel name to send watchdog alerts to (must match a real channel name)
DISCORD_ALERT_CHANNEL = "tarn"
# Maximum age (seconds) of a stale lock before we override it.
# This should exceed the worst-case single-run time (9 agents × 5s timeout + 15s restart wait).
LOCK_MAX_AGE_SEC = 180

# Mission Control API settings (read from env or defaults matching bin/mc)
MC_BASE_URL = os.environ.get("MC_BASE_URL", "http://localhost:3333")
MC_API_KEY  = os.environ.get("MC_API_KEY", "462f220e3c3f15324825a86373da874f92302bf6fc646e3330731468cc959c22")

# ── Helpers ───────────────────────────────────────────────────────────────────

def ts() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def log(msg: str) -> None:
    print(f"[{ts()}] {msg}", flush=True)


def load_config() -> dict:
    with open(CONFIG_FILE) as f:
        return json.load(f)


def load_env(path: Path) -> dict:
    """Parse a simple KEY=VALUE .env file."""
    env = {}
    if not path.exists():
        return env
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        m = re.match(r'^([A-Z_][A-Z0-9_]*)=(.*)$', line)
        if m:
            env[m.group(1)] = m.group(2).strip('"').strip("'")
    return env


def get_discord_token() -> Optional[str]:
    env = load_env(TARN_ENV)
    return env.get("DISCORD_BOT_TOKEN")


def send_discord(token: str, channel_name: str, text: str) -> bool:
    """Send a message to a named Discord channel via the bot API.

    Fetches guild list, then channel list, then posts to the first matching channel.
    Returns True on success, False on failure.
    """
    headers = {
        "Authorization": f"Bot {token}",
        "Content-Type": "application/json",
    }

    def _api_get(path: str):
        req = urllib.request.Request(
            f"https://discord.com/api/v10{path}",
            headers=headers,
            method="GET",
        )
        with urllib.request.urlopen(req, timeout=10) as resp:
            return json.load(resp)

    try:
        guilds = _api_get("/users/@me/guilds")
        if not isinstance(guilds, list):
            log(f"Discord send failed: unexpected guilds response: {guilds}")
            return False
    except Exception as e:
        log(f"Discord send failed (guilds fetch): {e}")
        return False

    channel_name_lower = channel_name.lower()

    for guild in guilds:
        guild_id = guild.get("id")
        if not guild_id:
            continue
        try:
            channels = _api_get(f"/guilds/{guild_id}/channels")
        except Exception as e:
            log(f"Discord send failed (channels fetch for guild {guild_id}): {e}")
            continue

        channel_id = None
        for ch in channels:
            if ch.get("type") == 0 and ch.get("name", "").lower() == channel_name_lower:
                channel_id = ch.get("id")
                break

        if not channel_id:
            continue

        payload = json.dumps({"content": text}).encode()
        req = urllib.request.Request(
            f"https://discord.com/api/v10/channels/{channel_id}/messages",
            data=payload,
            headers=headers,
            method="POST",
        )
        try:
            with urllib.request.urlopen(req, timeout=10) as resp:
                result = json.load(resp)
                if "id" in result:
                    return True
                log(f"Discord send failed (post): {result}")
                return False
        except Exception as e:
            log(f"Discord send failed (post to channel {channel_id}): {e}")
            return False

    log(f"Discord send failed: channel '#{channel_name}' not found on any guild")
    return False


def ping_agent(name: str, port: int) -> tuple[bool, str, dict]:
    """Returns (is_healthy, detail, bots_status).

    bots_status is a dict like {"telegram": True, "discord": True} when the
    /health endpoint includes bot connectivity info; empty dict otherwise.
    """
    url = f"http://127.0.0.1:{port}/health"
    req = urllib.request.Request(url, method="GET")
    try:
        with urllib.request.urlopen(req, timeout=HEALTH_TIMEOUT) as resp:
            body = json.load(resp)
            status = body.get("status", "")
            bots = body.get("bots", {})
            # "ok" and "degraded" both mean the process is alive
            if status in ("ok", "degraded"):
                return True, status, bots
            return False, f"unexpected response: {body}", {}
    except urllib.error.URLError as e:
        return False, f"connection refused or timeout: {e.reason}", {}
    except Exception as e:
        return False, str(e), {}


def load_state() -> dict:
    if STATE_FILE.exists():
        try:
            return json.loads(STATE_FILE.read_text())
        except Exception:
            pass
    return {}


def save_state(state: dict) -> None:
    STATE_FILE.write_text(json.dumps(state, indent=2))


def in_cooldown(state: dict, name: str) -> bool:
    last = state.get(name, {}).get("last_alert_ts")
    if not last:
        return False
    elapsed = time.time() - last
    return elapsed < (COOLDOWN_MINUTES * 60)


def check_bot_health(name: str, port: int, discord_token: Optional[str]) -> None:
    """After a successful restart, verify bots are connected; alert if not."""
    _, _, bots = ping_agent(name, port)
    if not bots:
        # Agent doesn't expose bot status yet — nothing to check.
        return
    deaf = [bot_name for bot_name, ok in bots.items() if not ok]
    if not deaf:
        log(f"  bot health: all bots connected for {name}")
        return
    msg = (
        f"⚠️ {name} restarted and HTTP is healthy, but bot(s) did not connect: "
        f"{', '.join(deaf)}. Check logs manually."
    )
    log(f"  bot health: {msg}")
    if discord_token:
        send_discord(discord_token, DISCORD_ALERT_CHANNEL, msg)


def try_restart(name: str, port: int, discord_token: Optional[str] = None) -> bool:
    """
    Restart a dead agent using bin/restart-agent.

    All agents (including tarn) use the same restart-agent script which handles
    the full SIGTERM → wait → SIGKILL → TIME_WAIT → launch sequence.  This
    eliminates the subprocess.Popen race condition where a hung process holding
    the port causes the new process to fail binding silently.
    """
    restart_agent = HOLLOW_ROOT / "bin" / "restart-agent"
    if not restart_agent.exists():
        log(f"  restart: bin/restart-agent not found, skipping")
        return False

    log(f"  restart: attempting to relaunch {name} (port {port})...")

    # Build the launch command for this agent.
    # Tarn has fixed well-known dirs; all others derive dirs from convention.
    UV_BIN = "/home/tchism/.local/bin/uv"

    if name == "tarn":
        identity_dir = HOLLOW_ROOT / "agents" / "tarn"
        memory_dir   = HOLLOW_ROOT / "agent-memory" / "tarn"
        data_dir     = HOLLOW_ROOT / "data" / "tarn"
    else:
        # Read config to verify the agent exists and to get its model setting
        cfg = load_config()
        all_agents = [cfg["coordinator"]] + cfg.get("agents", [])
        agent_cfg = next((a for a in all_agents if a["name"] == name), None)
        if not agent_cfg:
            log(f"  restart: {name} not found in config, skipping")
            return False

        identity_dir = HOLLOW_ROOT / "agents" / name
        memory_dir   = HOLLOW_ROOT / "agent-memory" / name
        data_dir     = HOLLOW_ROOT / "data" / name

        if not identity_dir.exists() or not memory_dir.exists():
            log(f"  restart: agent dirs not found for {name}, skipping")
            return False

    launch_cmd = [
        UV_BIN, "run", "python", "-m", "src.main",
        "--port", str(port),
        "--identity-dir", str(identity_dir),
        "--memory-dir", str(memory_dir),
        "--data-dir", str(data_dir),
    ]

    try:
        # bin/restart-agent signature: [--reason REASON] NAME PORT LAUNCH_CMD...
        # Log file is derived internally as data/<NAME>.log.
        reason = f"watchdog: {name} health check failed (connection refused)"
        subprocess.run(
            ["bash", str(restart_agent), "--reason", reason, name, str(port)] + launch_cmd,
            cwd=str(HOLLOW_ROOT),
            check=False,
        )
    except Exception as e:
        log(f"  restart: restart-agent failed for {name}: {e}")
        return False

    # restart-agent waits 2s internally for TIME_WAIT; allow 15s total for bots
    # to connect before declaring the restart successful.
    time.sleep(15)
    healthy, detail, _ = ping_agent(name, port)
    if healthy:
        log(f"  restart: {name} is back up (via restart-agent)")
        check_bot_health(name, port, discord_token)
        return True
    else:
        log(f"  restart: {name} still down after restart-agent — {detail}")
        return False


# ── Stale lease reset ─────────────────────────────────────────────────────────

def mc_api(method: str, path: str, data=None, params=None):
    """Make a request to the Mission Control API. Returns parsed JSON or None on error."""
    url = f"{MC_BASE_URL}{path}"
    if params:
        url += "?" + urllib.parse.urlencode(params)
    body = json.dumps(data).encode() if data is not None else None
    req = urllib.request.Request(url, data=body, method=method)
    req.add_header("Content-Type", "application/json")
    req.add_header("x-api-key", MC_API_KEY)
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            return json.loads(resp.read().decode())
    except urllib.error.HTTPError as e:
        body_text = e.read().decode() if e.fp else ""
        log(f"  MC API HTTP {e.code} {method} {path}: {body_text[:200]}")
        return None
    except urllib.error.URLError as e:
        log(f"  MC API connection error {method} {path}: {e.reason}")
        return None
    except Exception as e:
        log(f"  MC API error {method} {path}: {e}")
        return None


def reset_stale_leases(cfg: dict) -> int:
    """
    Query MC for in_progress tasks with expired leases and reset them to ready.

    Uses hollow.config.json watchdog.heartbeat_interval_minutes as the grace period:
    a task whose lease_expires_at is in the past has not received a heartbeat within
    the expected window, meaning task_executor likely died mid-task.

    Returns the count of tasks reset.
    """
    watchdog_cfg = cfg.get("watchdog", {})
    # We don't add extra grace beyond what lease_expires_at already encodes.
    # If the lease is expired it is definitively stale.

    tasks = mc_api("GET", "/api/tasks", params={"status": "in_progress"})
    if tasks is None:
        log("  stale-lease: could not reach MC — skipping lease reset")
        return 0
    if not isinstance(tasks, list):
        log(f"  stale-lease: unexpected tasks response type: {type(tasks)}")
        return 0

    now = datetime.now(timezone.utc)
    reset_count = 0

    for task in tasks:
        task_id    = task.get("id", "?")
        title      = task.get("title", "")[:60]
        locked_by  = task.get("locked_by") or "unknown"
        lease_str  = task.get("lease_expires_at")

        if not lease_str:
            # No lease set — not a task_executor-managed task; skip
            continue

        try:
            # Parse ISO8601; Python's fromisoformat handles trailing Z in 3.11+
            # For older Pythons strip Z and append +00:00
            lease_str_norm = lease_str.replace("Z", "+00:00")
            lease_expires = datetime.fromisoformat(lease_str_norm)
        except ValueError:
            log(f"  stale-lease: could not parse lease_expires_at '{lease_str}' for task {task_id}")
            continue

        if lease_expires >= now:
            # Lease still valid
            continue

        age_minutes = (now - lease_expires).total_seconds() / 60
        log(f"  stale-lease: task {task_id} ({title!r}) — lease expired {age_minutes:.1f}m ago (locked_by={locked_by}), resetting to ready")

        result = mc_api(
            "PATCH",
            f"/api/tasks/{task_id}",
            data={
                "status": "ready",
                "locked_by": None,
                "lease_expires_at": None,
                "heartbeat_at": None,
            },
        )
        if result is None:
            log(f"  stale-lease: PATCH failed for task {task_id} — will retry next cycle")
            continue

        reset_count += 1

        # Emit activity log entry so there is a record of the reset
        mc_api(
            "POST",
            "/api/agent-activity",
            data={
                "agent": "watchdog",
                "action": f"stale-lease reset: {title!r} (task {task_id}) was in_progress with expired lease (locked_by={locked_by}, expired {age_minutes:.1f}m ago) — reset to ready",
                "action_type": "watchdog.stale_lease_reset",
                "payload": {
                    "task_id": task_id,
                    "task_title": task.get("title", ""),
                    "locked_by": locked_by,
                    "lease_expired_at": lease_str,
                    "expired_minutes_ago": round(age_minutes, 1),
                },
            },
        )

    if reset_count:
        log(f"  stale-lease: reset {reset_count} stale task(s) to ready")
    else:
        log("  stale-lease: no stale leases found")

    return reset_count


# ── Main ──────────────────────────────────────────────────────────────────────

def acquire_lock() -> bool:
    """
    Try to acquire an exclusive run lock using a PID file.

    Returns True if the lock was acquired (caller should proceed and release it).
    Returns False if another instance is already running (caller should exit).

    A stale lock older than LOCK_MAX_AGE_SEC is forcibly cleared so a crashed
    watchdog doesn't block future runs forever.
    """
    if LOCK_FILE.exists():
        try:
            content = LOCK_FILE.read_text().strip()
            parts   = content.split()
            pid     = int(parts[0]) if parts else 0
            age     = time.time() - LOCK_FILE.stat().st_mtime
        except Exception:
            # Unreadable lock — treat as stale
            age, pid = LOCK_MAX_AGE_SEC + 1, 0

        if age < LOCK_MAX_AGE_SEC:
            # Check if the PID is actually running
            if pid and os.path.exists(f"/proc/{pid}"):
                log(f"Another watchdog instance is running (pid={pid}, age={age:.0f}s) — exiting.")
                return False
            # PID is gone but lock is young; treat as stale (crashed process)
            log(f"Stale lock from dead pid={pid} (age={age:.0f}s) — overriding.")
        else:
            log(f"Stale lock older than {LOCK_MAX_AGE_SEC}s (age={age:.0f}s) — overriding.")

    # Write our PID to the lock file
    try:
        LOCK_FILE.write_text(f"{os.getpid()}\n")
    except Exception as e:
        log(f"WARNING: could not write lock file {LOCK_FILE}: {e} — proceeding anyway")
    return True


def release_lock() -> None:
    """Remove the lock file if it still belongs to us."""
    try:
        if LOCK_FILE.exists():
            content = LOCK_FILE.read_text().strip().split()
            if content and int(content[0]) == os.getpid():
                LOCK_FILE.unlink()
    except Exception:
        pass  # Non-fatal


def main() -> None:
    parser = argparse.ArgumentParser(description="Hollow agent watchdog")
    parser.add_argument("--restart", action="store_true", help="Attempt to restart dead agents")
    parser.add_argument("--once",    action="store_true", help="Bypass cooldown, always alert")
    args = parser.parse_args()

    if not acquire_lock():
        return

    try:
        _main(args)
    finally:
        release_lock()


def _main(args) -> None:
    cfg           = load_config()
    discord_token = get_discord_token()
    state         = load_state()

    if not discord_token:
        log("ERROR: DISCORD_BOT_TOKEN not found — alerts will not be sent")

    # ── Stale lease reset ──────────────────────────────────────────────────────
    # Check for in_progress tasks whose lease has expired (task_executor died mid-task).
    # This runs unconditionally on every watchdog sweep, before the agent health checks.
    log("Checking for stale MC leases...")
    reset_stale_leases(cfg)

    # Build agent list from config
    agents = [{"name": cfg["coordinator"]["name"], "port": cfg["coordinator"]["port"]}]
    for a in cfg.get("agents", []):
        agents.append({"name": a["name"], "port": a["port"]})

    log(f"Checking {len(agents)} agents...")

    down  = []
    up    = []
    fixed = []

    for a in agents:
        name, port = a["name"], a["port"]

        # Check starting sentinel — skip health check if agent is in restart window.
        # Written by bin/restart-agent at the very start; cleared by main.py once
        # the process is healthy and listening on its port.
        _sentinel = Path(f"/tmp/{name}_starting")
        if _sentinel.exists():
            try:
                _sentinel_age = time.time() - _sentinel.stat().st_mtime
            except OSError:
                _sentinel_age = 9999
            if _sentinel_age < 300:  # 5-minute window
                log(f"  ⏳ {name}:{port} — restart in progress (sentinel {int(_sentinel_age)}s old), skipping health check")
                up.append(name)  # treat as up to avoid spurious alerts
                continue
            else:
                log(f"  {name}:{port} — stale starting sentinel ({int(_sentinel_age)}s old), clearing and checking health")
                try:
                    _sentinel.unlink()
                except OSError:
                    pass

        healthy, detail, bots = ping_agent(name, port)

        if healthy:
            up.append(name)
            bot_info = ""
            if bots:
                deaf = [b for b, ok in bots.items() if not ok]
                if deaf:
                    bot_info = f" (bots deaf: {', '.join(deaf)})"
            log(f"  ✓ {name}:{port}{bot_info}")
            # Clear any previous down state
            if name in state:
                state[name]["down"] = False
        else:
            log(f"  ✗ {name}:{port} — {detail}")

            if args.restart:
                restarted = try_restart(name, port, discord_token=discord_token)
                if restarted:
                    fixed.append(name)
                    if name in state:
                        state[name]["down"] = False
                    continue  # don't alert if we fixed it

            down.append({"name": name, "port": port, "detail": detail})
            state.setdefault(name, {})["down"] = True

    save_state(state)

    if not down and not fixed:
        log("All agents healthy.")
        return

    # Build alert message
    lines = ["⚠️ hollow watchdog alert"]
    for d in down:
        lines.append(f"  ✗ {d['name']} (:{d['port']}) — {d['detail']}")
    if fixed:
        lines.append("")
        for name in fixed:
            lines.append(f"  ↺ {name} — restarted successfully")
    if up:
        lines.append(f"\n✓ healthy: {', '.join(up)}")
    lines.append(f"\n{ts()}")

    alert_msg = "\n".join(lines)

    # Filter to agents that aren't in cooldown (unless --once)
    alertable = [
        d for d in down
        if args.once or not in_cooldown(state, d["name"])
    ]

    if not alertable:
        log(f"All {len(down)} down agent(s) in cooldown — no alert sent.")
        return

    log(f"Sending alert for: {[d['name'] for d in alertable]}")

    if discord_token:
        sent = send_discord(discord_token, DISCORD_ALERT_CHANNEL, alert_msg)
        if sent:
            log(f"Discord alert sent to #{DISCORD_ALERT_CHANNEL}.")
            for d in alertable:
                state.setdefault(d["name"], {})["last_alert_ts"] = time.time()
            save_state(state)
        else:
            log("Discord alert FAILED.")
    else:
        log("No Discord token — would have sent:")
        log(alert_msg)


if __name__ == "__main__":
    main()
