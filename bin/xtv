#!/usr/bin/env python3
"""Analyze a tweet (including video) via xAI/Grok's native X platform access.

Grok has native X platform integration — it can pull the actual video from X,
extract frames, pull subtitles/captions, and generate a speech-to-text transcript.
This is the same capability as using Grok on x.com directly.

Usage:
  xtv "https://x.com/user/status/12345"
  xtv "https://x.com/user/status/12345" --prompt "What is being said in the video?"
"""

import json
import os
import sys
from pathlib import Path


def _load_env_file(path):
    p = Path(path)
    if not p.exists():
        return
    for line in p.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, val = line.partition("=")
        key = key.strip()
        val = val.strip().strip('"').strip("'")
        if key and key not in os.environ:
            os.environ[key] = val


_hollow_root = Path(__file__).parent.parent
_load_env_file(_hollow_root / ".env")
_load_env_file(_hollow_root / "agents" / "tarn" / ".env")

API_KEY = os.environ.get("XAI_API_KEY", "")
ENDPOINT = "https://api.x.ai/v1/responses"


def main():
    if len(sys.argv) < 2:
        print("Usage: xtv \"<tweet_url>\" [--prompt=\"custom prompt\"]")
        sys.exit(1)

    tweet_url = sys.argv[1]
    custom_prompt = None
    for arg in sys.argv[2:]:
        if arg.startswith("--prompt="):
            custom_prompt = arg.split("=", 1)[1]

    if not API_KEY:
        print("Error: XAI_API_KEY not set", file=sys.stderr)
        sys.exit(1)

    if custom_prompt:
        if tweet_url not in custom_prompt:
            prompt = f"Tweet URL: {tweet_url}\n\n{custom_prompt}"
        else:
            prompt = custom_prompt
    else:
        prompt = (
            f"Please analyze this tweet: {tweet_url}\n\n"
            "Provide:\n"
            "1. The full text of the tweet\n"
            "2. Who posted it and any relevant context about them\n"
            "3. If there is a video or image, provide a complete verbatim transcript of all spoken words "
            "and describe what is shown visually in detail\n"
            "4. The core message or argument being made — including any philosophical, spiritual, or "
            "ideological points the speaker makes\n"
            "5. Any relevant replies or quote tweets if notable"
        )

    try:
        import httpx
    except ImportError:
        print("Error: httpx not installed. Run: uv add httpx", file=sys.stderr)
        sys.exit(1)

    try:
        with httpx.Client() as client:
            resp = client.post(
                ENDPOINT,
                headers={
                    "Authorization": f"Bearer {API_KEY}",
                    "Content-Type": "application/json",
                },
                json={
                    "model": "grok-4-1-fast",
                    "input": [
                        {
                            "role": "system",
                            "content": (
                                "You have native access to X/Twitter content including videos. "
                                "When given a tweet URL, retrieve and analyze the full tweet. "
                                "For videos: pull the actual video, extract frames, use subtitles/captions "
                                "if available, and generate an accurate speech-to-text transcript. "
                                "Transcribe all spoken words as accurately as possible."
                            ),
                        },
                        {"role": "user", "content": prompt},
                    ],
                    "tools": [{"type": "web_search"}],
                },
                timeout=120,
            )

            if resp.status_code != 200:
                print(f"API error {resp.status_code}: {resp.text[:500]}", file=sys.stderr)
                sys.exit(1)

            data = resp.json()
            output = data.get("output", [])
            for item in output:
                if item.get("type") == "message":
                    for content in item.get("content", []):
                        if content.get("type") == "output_text":
                            print(content.get("text", ""))
                            annotations = content.get("annotations", [])
                            if annotations:
                                print("\n--- Sources ---")
                                for a in annotations:
                                    if a.get("type") == "url_citation":
                                        print(f"  {a.get('title', 'Untitled')}: {a.get('url', '')}")
            if not output:
                print(json.dumps(data, indent=2))

    except httpx.RequestError as e:
        print(f"Connection error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
