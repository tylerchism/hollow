#!/usr/bin/env bash
# send_tg — DISABLED. Telegram has been removed; use send_discord or send_msg instead.
#
# This script is kept as a no-op shim so any legacy calls fail gracefully
# with a clear error message rather than a cryptic "command not found".

echo "send_tg: Telegram has been disabled. Use 'send_discord' or 'send_msg' instead." >&2
exit 1
