#!/usr/bin/env bash
# send_discord — Send an interim Discord message during a long-running task.
#
# Usage: send_discord "message text"
#
# Reads DISCORD_BOT_TOKEN from agents/tarn/.env
# Reads active channel_id from /tmp/tarn_active_discord_channel
# (written by discord_channel.py on each inbound message)
#
# If the active channel has a dedicated webhook route (e.g. #trader-bot → Flux),
# the message is posted via webhook with the agent's display name instead of
# the bot token. The webhook URL is written to /tmp/tarn_active_discord_webhook
# and the display name to /tmp/tarn_active_discord_webhook_name.
#
# Call this BEFORE starting slow work so Tyler gets a heads-up:
#   send_discord "on it, checking the repo..."

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOLLOW_ROOT="$(dirname "$SCRIPT_DIR")"
TARN_ENV="$HOLLOW_ROOT/agents/tarn/.env"
ACTIVE_CHANNEL_FILE="/tmp/tarn_active_discord_channel"
ACTIVE_WEBHOOK_FILE="/tmp/tarn_active_discord_webhook"
ACTIVE_WEBHOOK_NAME_FILE="/tmp/tarn_active_discord_webhook_name"

if [[ $# -lt 1 ]]; then
    echo "Usage: send_discord \"message text\"" >&2
    exit 1
fi

MESSAGE="$*"

# Read active channel_id
if [[ ! -f "$ACTIVE_CHANNEL_FILE" ]]; then
    echo "send_discord: no active Discord channel (no inbound message received yet)" >&2
    exit 1
fi

CHANNEL_ID="$(cat "$ACTIVE_CHANNEL_FILE")"
if [[ -z "$CHANNEL_ID" ]]; then
    echo "send_discord: active channel_id is empty" >&2
    exit 1
fi

# ── Webhook path (routed channels like #trader-bot → Flux) ───────────────────
# If a webhook file exists, post via webhook as the routed agent name.
# This avoids using the bot token and posts with the correct display name.
if [[ -f "$ACTIVE_WEBHOOK_FILE" ]]; then
    WEBHOOK_URL="$(cat "$ACTIVE_WEBHOOK_FILE")"
    DISPLAY_NAME="Flux"
    if [[ -f "$ACTIVE_WEBHOOK_NAME_FILE" ]]; then
        DISPLAY_NAME="$(cat "$ACTIVE_WEBHOOK_NAME_FILE")"
    fi

    if [[ -n "$WEBHOOK_URL" ]]; then
        PAYLOAD="$(python3 -c "
import json, sys
print(json.dumps({'content': sys.argv[1], 'username': sys.argv[2]}))
" "$MESSAGE" "$DISPLAY_NAME")"

        HTTP_STATUS="$(curl -s -o /dev/null -w "%{http_code}" -X POST \
            "$WEBHOOK_URL" \
            -H "Content-Type: application/json" \
            -d "$PAYLOAD")"

        if [[ "$HTTP_STATUS" == "204" || "$HTTP_STATUS" == "200" ]]; then
            exit 0
        else
            echo "send_discord: webhook POST returned HTTP $HTTP_STATUS — falling back to bot API" >&2
        fi
    fi
fi

# ── Bot API path (default: #tarn and DMs) ────────────────────────────────────
if [[ ! -f "$TARN_ENV" ]]; then
    echo "send_discord: tarn .env not found at $TARN_ENV" >&2
    exit 1
fi

TOKEN=""
while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    [[ "$line" =~ ^# ]] && continue
    [[ "$line" =~ ^DISCORD_BOT_TOKEN=(.+)$ ]] && TOKEN="${BASH_REMATCH[1]}" && break
done < "$TARN_ENV"

if [[ -z "$TOKEN" ]]; then
    echo "send_discord: DISCORD_BOT_TOKEN not found in $TARN_ENV" >&2
    exit 1
fi

# Send via Discord Bot API
RESPONSE="$(curl -s -X POST \
    "https://discord.com/api/v10/channels/${CHANNEL_ID}/messages" \
    -H "Authorization: Bot ${TOKEN}" \
    -H "Content-Type: application/json" \
    -d "{\"content\": $(python3 -c "import json,sys; print(json.dumps(sys.argv[1]))" "$MESSAGE")}")"

# Check for Discord API error (presence of "id" field in response means success)
OK="$(echo "$RESPONSE" | python3 -c "import json,sys; d=json.load(sys.stdin); print('true' if 'id' in d else 'false')" 2>/dev/null || echo "false")"

if [[ "$OK" != "true" ]]; then
    echo "send_discord: Discord API error: $RESPONSE" >&2
    exit 1
fi

exit 0
